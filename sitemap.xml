<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9
        http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">

  <!-- ===================================================== -->
  <!-- Homepage - Highest Priority -->
  <!-- ===================================================== -->
  <url>
    <!-- Absolute URL to homepage -->
    <loc>https://gatcr.com/</loc>
    <!-- Last modification date - Update when content changes -->
    <lastmod>2026-01-12</lastmod>
    <!-- Priority: 1.0 = highest (homepage should be highest) -->
    <priority>1.0</priority>
    <!-- Change frequency: How often page content changes -->
    <changefreq>weekly</changefreq>
  </url>

  <!-- ===================================================== -->
  <!-- Main Index Page (if different from root) -->
  <!-- ===================================================== -->
  <url>
    <loc>https://gatcr.com/index.html</loc>
    <lastmod>2026-01-12</lastmod>
    <!-- Slightly lower priority than root URL -->
    <priority>0.9</priority>
    <changefreq>weekly</changefreq>
  </url>

  <!-- ===================================================== -->
  <!-- Note: 404.html is EXCLUDED from sitemap -->
  <!-- Error pages should not be indexed for SEO -->
  <!-- ===================================================== -->

</urlset>

